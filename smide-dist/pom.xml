<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smide</groupId>
        <artifactId>smide-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>smide-dist</artifactId>
    <packaging>pom</packaging>
    <name>smIDE Distribution</name>
    <description>Runs the IDE from source with every bundled plugin on the class path, and assembles app/</description>

    <properties>
        <!--
            jpackage, in whichever JDK Maven is running on. Overridden for Windows below,
            where the file carries an extension; checked in the dist profile, because a
            JRE or an IDE's bundled runtime has no jpackage at all.
        -->
        <jpackage.tool>${java.home}/bin/jpackage</jpackage.tool>
        <smide.debugLayout>false</smide.debugLayout>
        <smide.open></smide.open>
        <!-- jpackage rejects a version with a qualifier, so the shipped one is plain. -->
        <app.version>0.1.0</app.version>
        <!--
            The modules the bundled runtime is jlinked with. Wider than a jdeps run would
            give, because half of these are reached by reflection and would be found only
            when a user hit the feature: jdk.jdi is the debugger, jdk.crypto.ec is TLS,
            jdk.zipfs is reading a jar as a filesystem, jdk.localedata is every locale but
            English. A runtime missing one of these fails at the user rather than here.

            jdk.jsobject is not reflection but JNI, and it fails harder than the rest.
            WebView's native WebKit looks netscape.javascript.JSObject up with FindClass
            to hand back what a script evaluated; a runtime without it returns null,
            which the caller does not check, and the JVM dies on the spot in
            GetStaticFieldID. That is every Markdown preview and every assistant answer,
            so nothing here may drop it.

            jdk.unsupported.desktop is what javafx.swing's SwingNode is built on (the
            jdk.swing.interop classes). The terminal is a Swing emulator in a SwingNode, and
            a runtime without the module threw NoClassDefFoundError making one: pressing +
            in the Terminal window opened nothing and said nothing.
        -->
        <app.modules>java.base,java.compiler,java.desktop,java.instrument,java.logging,java.management,java.naming,java.net.http,java.prefs,java.rmi,java.scripting,java.security.jgss,java.sql,java.xml,java.xml.crypto,jdk.attach,jdk.charsets,jdk.compiler,jdk.crypto.cryptoki,jdk.crypto.ec,jdk.dynalink,jdk.httpserver,jdk.jdi,jdk.jdwp.agent,jdk.jsobject,jdk.localedata,jdk.management,jdk.unsupported,jdk.unsupported.desktop,jdk.zipfs</app.modules>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-java</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-markdown</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-git</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-terminal</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-kotlin</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-python</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-web</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-shell</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-sql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lombok</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-go</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-rust</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-cpp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-csharp</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-lang-docker</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-database</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.smide</groupId>
            <artifactId>smide-plugin-assistant</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Every runtime jar in one directory, which is what jpackage takes as its
                input and what a launcher script would put on the class path. Copied
                rather than referenced so the result does not depend on ~/.m2 existing.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.7.1</version>
                <executions>
                    <execution>
                        <id>collect-runtime</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <overWriteIfNewer>true</overWriteIfNewer>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                mvn -pl smide-dist exec:exec

                A separate JVM rather than exec:java: JavaFX wants to own the process it
                starts in, and Maven's own class loader in the same JVM confuses it.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <executable>java</executable>
                    <arguments>
                        <argument>-Dsmide.dev=true</argument>
                        <argument>-Dsmide.debugLayout=${smide.debugLayout}</argument>
                        <argument>-cp</argument>
                        <classpath/>
                        <argument>com.smide.Launcher</argument>
                        <argument>${smide.open}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>

        <profile>
            <id>jpackage-on-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <jpackage.tool>${java.home}/bin/jpackage.exe</jpackage.tool>
            </properties>
        </profile>
        <!--
            mvn -Pdist package

            An application anybody can run: jpackage puts the jars from app/lib beside a
            runtime jlinked from the modules above, and the result needs no JDK, no Maven
            and no network. Built as an app-image rather than an installer because that is
            the one format every platform can produce without a third-party toolchain -
            WiX on Windows, dpkg or rpm on Linux - and unpacking a directory is an install
            everybody already knows how to do.

            jpackage builds for the machine it runs on, so this profile produces one
            platform's package. The release workflow runs it on all three.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <!--
                        Both of these used to be found out at the last step of a build that
                        had already run for minutes, and neither said what was wrong: a
                        runtime without jpackage gave "CreateProcess error=2", and a JDK
                        without jmods gave "jlink failed with: This JDK does not support
                        linking from the current run-time image". Checked here, the build
                        stops in a second and names the Java it is unhappy with.

                        jmods is where jlink reads the modules the runtime is built from.
                        A JDK packaged without it - some distributions' 24 and newer - can
                        compile smIDE perfectly well and still not package it.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>jdk-can-package</id>
                                <phase>validate</phase>
                                <goals><goal>enforce</goal></goals>
                                <configuration>
                                    <rules>
                                        <requireFilesExist>
                                            <files>
                                                <file>${jpackage.tool}</file>
                                            </files>
                                            <message>
This JDK has no jpackage, so the application cannot be built with it:
    ${java.home}
Point JAVA_HOME at a full JDK 21 or newer - not a JRE, and not the runtime
bundled with another program - and build again.
                                            </message>
                                        </requireFilesExist>
                                        <requireFilesExist>
                                            <files>
                                                <file>${java.home}/jmods</file>
                                            </files>
                                            <message>
This JDK has no jmods directory, so jlink cannot build a runtime from it:
    ${java.home}
Some distributions package their newer JDKs without it. Point JAVA_HOME at one
that has a jmods directory - a JDK 21 from the same distribution usually does,
as does any build from Adoptium - and build again.
                                            </message>
                                        </requireFilesExist>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        jpackage refuses to write into a directory that already exists,
                        so a second run has to start from nothing. Only target/dist is
                        removed: cleaning the rest would rebuild the world every time.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-clean-plugin</artifactId>
                        <version>3.4.0</version>
                        <executions>
                            <execution>
                                <id>clear-dist</id>
                                <phase>prepare-package</phase>
                                <goals><goal>clean</goal></goals>
                                <configuration>
                                    <excludeDefaultDirectories>true</excludeDefaultDirectories>
                                    <filesets>
                                        <fileset>
                                            <directory>${project.build.directory}/dist</directory>
                                        </fileset>
                                    </filesets>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${jpackage.tool}</executable>
                                    <!--
                                        Not merged with the plugin-level arguments above,
                                        which are how the IDE is run from source: without
                                        this, jpackage is handed -cp and the whole class
                                        path and refuses with "Invalid Option".
                                    -->
                                    <arguments combine.self="override">
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--name</argument>
                                        <argument>smIDE</argument>
                                        <argument>--app-version</argument>
                                        <argument>${app.version}</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/app/lib</argument>
                                        <argument>--main-jar</argument>
                                        <argument>smide-core-${project.version}.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>com.smide.Launcher</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>--add-modules</argument>
                                        <argument>${app.modules}</argument>
                                        <!--
                                            What jlink is told, instead of what jpackage would tell
                                            it. jpackage's own list begins by stripping native debug
                                            symbols, which runs objcopy, a binutils program that a
                                            machine with a JDK and Maven on it need not have. Without
                                            it the whole build ran and then died at the last step,
                                            jlink failing with: Cannot run program "objcopy". These
                                            two need nothing beyond the JDK. The runtime is a few MB
                                            larger for keeping its own libraries' debug symbols.
                                        -->
                                        <argument>--jlink-options</argument>
                                        <argument>--no-man-pages --no-header-files</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Xmx2g</argument>
                                        <argument>--vendor</argument>
                                        <argument>smIDE</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
